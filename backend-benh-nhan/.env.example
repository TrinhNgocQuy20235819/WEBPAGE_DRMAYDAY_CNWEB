# Cổng chạy dịch vụ Backend Phân hệ Bệnh nhân
PORT=3000

# Cấu hình kết nối PostgreSQL (Nếu có PostgreSQL Server chạy độc lập)
# Khi USE_EMBEDDED_PG=true (mặc định nếu chưa bật PostgreSQL dịch vụ ngoài),
# hệ thống sẽ khởi chạy nhân PostgreSQL nhúng (PGlite) và nạp trực tiếp
# file ../mayday-database/final_restructured.sql nguyên bản 100%.
USE_EMBEDDED_PG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drmayday

# Đường dẫn tới file SQL gốc của nhóm (TUYỆT ĐỐI KHÔNG CHỈNH SỬA FILE NÀY)
SQL_SCHEMA_PATH=../mayday-database/final_restructured.sql

# Cấu hình bảo mật JWT
JWT_SECRET=drmayday_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Cấu hình lưu trữ tệp đính kèm (Ảnh tổn thương da / Ảnh câu trả lời)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

