meta {
  name: 01 Patient Ping Allowed
  type: http
  seq: 1
  tags: [automated]
}

get {
  url: {{baseUrl}}/api/v1/patient/ping
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{patientToken}}
}

script:pre-request {
  const token = bru.getVar("patientToken") || bru.getEnvVar("patientToken");
  if (!token) throw new Error("Missing patientToken; run the prerequisite patient login first.");
  bru.setVar("patientToken", token);
}

tests {
  const body = res.getBody();
  test("HTTP 200 and ApiResponse 1000", function () {
    expect(res.getStatus()).to.equal(200);
    expect(body.code).to.equal(1000);
    expect(body.message).to.equal("OK");
  });
  test("No sensitive error/user fields", function () {
    const text = JSON.stringify(body);
    expect(text).not.to.match(/matKhauMaHoa|mat_khau_ma_hoa|stackTrace|jdbc:postgresql|jwt\.secret/i);
    expect(body).not.to.have.property("password");
    if (body.data && body.data.user) expect(body.data.user).not.to.have.property("password");
  });
}
