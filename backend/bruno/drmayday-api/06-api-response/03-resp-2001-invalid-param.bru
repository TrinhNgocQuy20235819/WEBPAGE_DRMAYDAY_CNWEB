meta {
  name: 03 ApiResponse 2001 Invalid Param
  type: http
  seq: 3
  tags: [automated]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  const body = res.getBody();
  test("HTTP 400 and ApiResponse 2001", function () {
    expect(res.getStatus()).to.equal(400);
    expect(body.code).to.equal(2001);
    expect(body.message).to.equal("Missing required parameter");
  });
  test("No sensitive error/user fields", function () {
    const text = JSON.stringify(body);
    expect(text).not.to.match(/matKhauMaHoa|mat_khau_ma_hoa|stackTrace|jdbc:postgresql|jwt\.secret/i);
    expect(body).not.to.have.property("password");
    if (body.data && body.data.user) expect(body.data.user).not.to.have.property("password");
  });
  test("Validation details", function () { expect(body.data).to.have.property("phone"); expect(body.data).to.have.property("password"); });
}
