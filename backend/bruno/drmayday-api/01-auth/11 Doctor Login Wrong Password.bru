meta {
  name: 11 Doctor Login Wrong Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{doctorPhone}}",
    "password": "{{doctorPassword}}"
  }
}

script:pre-request {
  const phone = bru.getEnvVar("doctorPhone");
  
  if (!phone) {
    throw new Error("Missing doctorPhone");
  }
  
  req.setBody({
    phone: phone,
    password: "WrongPassword123!"
  });
}

tests {
  test("Wrong password returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("Returns error code 3008", function () {
    expect(res.getBody().code).to.equal(3008);
  });
}
