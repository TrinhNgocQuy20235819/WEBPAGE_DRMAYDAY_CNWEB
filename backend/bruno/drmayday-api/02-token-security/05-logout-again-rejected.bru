meta {
  name: 05 Logout Again Rejected
  type: http
  seq: 5
  tags: [automated]
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{patientTokenA}}
}

script:pre-request {
  if (!(bru.getVar("patientTokenA") || bru.getEnvVar("patientTokenA"))) throw new Error("Missing patientTokenA; run the prerequisite login or prepare the manual fixture.");
}

tests {
  const body = res.getBody();
  test("HTTP 401 and ApiResponse 3008", function () {
    expect(res.getStatus()).to.equal(401);
    expect(body.code).to.equal(3008);
    expect(body.message).to.equal("Phien dang nhap khong hop le hoac da het han");
  });
  test("No sensitive error/user fields", function () {
    const text = JSON.stringify(body);
    expect(text).not.to.match(/matKhauMaHoa|mat_khau_ma_hoa|stackTrace|jdbc:postgresql|jwt\.secret/i);
    expect(body).not.to.have.property("password");
    if (body.data && body.data.user) expect(body.data.user).not.to.have.property("password");
  });
}
