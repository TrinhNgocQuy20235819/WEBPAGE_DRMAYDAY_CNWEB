meta {
  name: 01 Missing Attachment (7001)
  type: http
  seq: 1
  tags: [automated, ai-inference]
}

post {
  url: {{baseUrl}}/api/v1/ai/inference
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "attachment_id": 99999999
  }
}

tests {
  const body = res.getBody();
  test("HTTP 400/404 and ApiResponse 6001/7001", function () {
    expect([400, 404]).to.include(res.getStatus());
    expect([6001, 7001]).to.include(body.code);
  });
}
